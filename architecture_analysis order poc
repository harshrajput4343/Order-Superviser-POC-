from sqlalchemy import case, func

result = await db.execute(
    select(
        func.count(Run.id).label("total_runs"),
        func.count(case((Run.status.in_(active_statuses), 1))).label("active_runs"),
        func.count(case((Run.status.in_(done_statuses), 1))).label("completed_runs"),
    )
)
```

